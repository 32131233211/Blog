---
/* ============================================================
   ENTRADA 4 (parte 2) — Evidencia (fotos) y Descripción
   ============================================================
   Estructura simétrica de dos columnas principales:
     · Columna Izquierda: Capacitación 3 (Pautas de seguridad digital).
     · Columna Derecha: Capacitación 4 (Enlaces seguros, documentos y apps de trámites).

   Cada columna contiene una cuadrícula idéntica de 6 cuadros de
   imagen distribuidos en 3 filas (2 cuadros por fila):
     - Fila 1: Cuadros 1 y 2
     - Fila 2: Cuadros 3 y 4
     - Fila 3: Cuadros 5 y 6

   CÓMO ASIGNAR FOTOS REALES:
   Colocar los archivos en public/assets/sesion-3/ y public/assets/sesion-4/
   (o ruta pública), y reemplazar la ruta en `src` correspondiente
   (ej. "/assets/sesion-3/foto-1.jpeg"), ajustando también el texto
   descriptivo de `alt` y `descripcion`.

   AJUSTE DE ENCUADRE (`ajuste`):
   Por defecto la imagen llena el recuadro 4:3 recortando sobrante
   (ideal para fotos horizontales). Para capturas de pantalla del
   celular (verticales), agregar `ajuste: "contain"` para mostrarlas
   completas sin recortar, con relleno a los lados en vez de perder
   contenido.
   ============================================================ */
import SeccionBase from "../../../../components/SeccionBase.astro";

interface FotoEvidencia {
  /** Ruta pública del archivo de imagen. Si es null, renderiza el cuadro de reserva punteado. */
  readonly src: string | null;
  /** Texto alternativo accesible que describe el contenido de la imagen. */
  readonly alt: string;
  /** Pie de foto o descripción detallada de la evidencia. */
  readonly descripcion: string;
  /** Etiqueta indicativa del cuadro mientras esté pendiente de imagen. */
  readonly etiqueta: string;
  /**
   * Cómo encajar la imagen dentro del recuadro 4:3.
   * "cover" (por defecto): llena el recuadro recortando sobrante — ideal para fotos horizontales.
   * "contain": muestra la imagen completa sin recortar, con relleno a los lados —
   * usar en capturas de pantalla verticales, donde recortar perdería contenido relevante.
   */
  readonly ajuste?: "cover" | "contain";
}

/* ------------------------------------------------------------
   COLUMNA IZQUIERDA: CAPACITACIÓN 3 (6 cuadros en 3 filas de 2)
   Facilitador: Sebastián Corrales Sepúlveda | Temática: Pautas de seguridad digital
   ------------------------------------------------------------ */
const FOTOS_CAPACITACION_3: readonly FotoEvidencia[] = [
  // Fila 1 (2 cuadros)
  {
    src: "/assets/sesion-3/Foto1.png",
    alt: "Demostración de detección de mensajes SMS sospechosos (smishing) con enlaces falsos.",
    descripcion: "Inicio y presentación de la capacitación.",
    etiqueta: "Cuadro 1 — Presentación de la capacitación",
  },
  {
    src: "/assets/sesion-3/Foto2.png",
    alt: "Identificación de remitentes no verificados y señales de phishing en la bandeja de correo electrónico.",
    descripcion: "Experiencias vividas con intetos de Fraudes.",
    etiqueta: "Cuadro 2 — Experiencias vividas con intetos de Fraudes",
  },
  // Fila 2 (2 cuadros)
  {
    src: "/assets/sesion-3/Foto3.png",
    alt: "Estrategia pedagógica para crear contraseñas robustas y memorables mediante frases clave.",
    descripcion: "Explicación de como esta construido un mensaje Fraudulento.",
    etiqueta: "Cuadro 3 — Manejo seguro de contraseñas",
  },
  {
    src: "/assets/sesion-3/Foto4.png",
    alt: "Explicación del segundo factor de autenticación (MFA) con código de verificación temporal en el celular.",
    descripcion: "Actividad para reconocer mensajes engañosos.",
    etiqueta: "Cuadro 4 — Construcción de mensajes Fraudulentos",
  },
  // Fila 3 (2 cuadros)
  {
    src: "/assets/sesion-3/Foto5.png",
    alt: "Verificación de aplicaciones en tiendas oficiales Google Play Store y advertencia sobre archivos APK externos.",
    descripcion:
      "Explicaón de como estan estructurados los correos de Fraudulentos y como reconocerlos.",
    etiqueta: "Cuadro 5 — Descarga segura de aplicaciones",
  },
  {
    src: "/assets/sesion-3/Foto6.png",
    alt: "Participantes respondiendo el cuestionario de evaluación sobre pautas de seguridad digital.",
    descripcion:
      "Consejos y reglas de seguridad para asegurar la integridad digital.",
    etiqueta: "Cuadro 6 — Cuestionario de seguridad",
  },
];

/* ------------------------------------------------------------
   COLUMNA DERECHA: CAPACITACIÓN 4 (6 cuadros en 3 filas de 2)
   Facilitador: Yeimi Liliana Calle Calvo | Temática: Navegación y organización
   ------------------------------------------------------------ */
const FOTOS_CAPACITACION_4: readonly FotoEvidencia[] = [
  // Fila 1 (2 cuadros)
  {
    src: "/assets/sesion-4/imagen-1.jpeg",
    alt: "Dos participantes frente a un computador siguiendo la sesión.",
    descripcion: "Participantes siguiendo la sesión desde el computador.",
    etiqueta: "Cuadro 1 — Participantes en la sesión",
    ajuste: "contain",
  },
  {
    src: "/assets/sesion-4/imagen-2.jpeg",
    alt: "Captura de la videollamada con la práctica de descarga de una copia de factura en el celular.",
    descripcion:
      "Práctica de descarga de una copia de factura desde el celular.",
    etiqueta: "Cuadro 2 — Descarga de factura",
    ajuste: "contain",
  },
  // Fila 2 (2 cuadros)
  {
    src: "/assets/sesion-4/imagen-3.jpeg",
    alt: "Captura de la videollamada con la diapositiva sobre verificar un enlace antes de compartirlo.",
    descripcion:
      "Explicación de cómo verificar un enlace antes de compartirlo.",
    etiqueta: "Cuadro 3 — Verificación de enlaces",
    ajuste: "contain",
  },
  {
    src: "/assets/sesion-4/imagen-4.png",
    alt: "Captura de la videollamada con el menú de transacciones de una aplicación bancaria en el celular.",
    descripcion:
      "Recorrido por el menú de transacciones de una aplicación bancaria.",
    etiqueta: "Cuadro 4 — Aplicación bancaria",
  },
  // Fila 3 (2 cuadros)
  {
    src: "/assets/sesion-4/imagen-5.png",
    alt: "Captura de la videollamada con la sección de atención en salud de una aplicación en el celular.",
    descripcion:
      "Práctica con la aplicación de salud: agendar citas y consultar resultados de exámenes.",
    etiqueta: "Cuadro 5 — Aplicación de salud",
  },
  {
    src: "/assets/sesion-4/imagen-6.png",
    alt: "Captura de la videollamada con la sección de servicios de una aplicación de pagos en el celular.",
    descripcion:
      "Exploración de los servicios y categorías de una aplicación de pagos.",
    etiqueta: "Cuadro 6 — Aplicación de pagos",
  },
