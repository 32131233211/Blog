---
/* ============================================================
   MAPA DE UBICACIÓN — un lugar, un mapa
   ============================================================
   Envuelve un mapa interactivo de Google Maps centrado en unas
   coordenadas. Se instancia UNA VEZ POR LUGAR; no se copia el
   iframe a mano en cada sección. Así, si algún día cambia el
   proveedor de mapas o el estilo del contenedor, se toca este
   archivo y TODOS los mapas del sitio cambian juntos.

   ------------------------------------------------------------
   SOBRE LA URL DEL MAPA — leer antes de tocar
   ------------------------------------------------------------
   Se usa la forma  google.com/maps?...&output=embed , que NO
   requiere API key ni cuenta de facturación. Funciona hoy, pero
   Google no la documenta oficialmente: si algún día dejara de
   cargar, la reemplazo oficial es el Maps Embed API:

     https://www.google.com/maps/embed/v1/place
       ?key=API_KEY&q=LAT,LNG&zoom=Z&language=es

   Para migrar sólo hay que cambiar la constante `src` de abajo
   y leer la key desde una variable de entorno PUBLIC_*.
   Ninguna sección del sitio se entera del cambio.

   ------------------------------------------------------------
   ACCESIBILIDAD (público adulto mayor — no negociable)
   ------------------------------------------------------------
   · El <iframe> lleva `title`: sin él, un lector de pantalla
     anuncia "marco" y nada más.
   · La ubicación se enuncia SIEMPRE en texto (título + coordenadas),
     nunca sólo dentro del mapa: quien no pueda operar el mapa
     igual recibe el dato.
   · El enlace "Abrir en Google Maps" cumple el mínimo táctil de
     44px y avisa que se abre en una pestaña nueva.
   ============================================================ */
interface Props {
  /** Latitud en grados decimales (norte positivo). */
  lat: number;
  /** Longitud en grados decimales (oeste negativo). */
  lng: number;
  /** Nombre del lugar. Encabeza la tarjeta y da contexto al mapa. */
  titulo: string;
  /** Línea opcional bajo el título para explicar por qué está este lugar. */
  descripcion?: string;
  /** Nivel de zoom inicial: 1 = mundo, 15 = barrio, 20 = edificio. */
  zoom?: number;
}

const { lat, lng, titulo, descripcion, zoom = 15 } = Astro.props;

/** Coordenadas legibles, para el texto visible y para el título del mapa. */
const coordenadas = `${lat.toFixed(6)}, ${lng.toFixed(6)}`;

/** Mapa incrustado e interactivo (zoom, arrastre, satélite, Street View). */
const src = `https://www.google.com/maps?q=${lat},${lng}&z=${zoom}&hl=es&output=embed`;

/** Enlace externo — esta forma sí es API oficial y estable de Google. */
const enlaceExterno = `https://www.google.com/maps/search/?api=1&query=${lat},${lng}`;
---

<figure class="flex flex-col">
  <div class="overflow-hidden rounded-md border border-line">
    <iframe
      src={src}
      title={`Mapa interactivo de ${titulo}. Coordenadas ${coordenadas}.`}
      class="block aspect-video w-full border-0"
      loading="lazy"
      allowfullscreen
      referrerpolicy="no-referrer-when-downgrade"></iframe>
  </div>

  <figcaption class="mt-sm">
    <p class="font-medium text-text">{titulo}</p>
    {descripcion && <p class="mt-xs text-sm text-text-muted">{descripcion}</p>}
    <p class="mt-xs text-sm text-text-muted">
      <span class="sr-only">Coordenadas geográficas:</span>
      {coordenadas}
    </p>

    <a
      href={enlaceExterno}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-xs inline-flex min-h-11 items-center gap-xs text-sm font-medium text-primary-700 underline hover:text-primary-600"
    >
      <svg
        class="size-5 shrink-0"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
        <circle cx="12" cy="10" r="3"></circle>
      </svg>
      Abrir en Google Maps
      <span class="sr-only">(se abre en una pestaña nueva)</span>
    </a>
  </figcaption>
</figure>
