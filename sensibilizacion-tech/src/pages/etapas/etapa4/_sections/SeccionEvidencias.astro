/* ------------------------------------------------------------
   COLUMNA DERECHA: CAPACITACIÓN 4 (6 cuadros en 3 filas de 2)
   Facilitador: Yeimi Liliana Calle Calvo | Temática: Navegación y organización
   ------------------------------------------------------------ */
const FOTOS_CAPACITACION_4: readonly FotoEvidencia[] = [
  // Fila 1 (2 cuadros)
  {
    src: "/assets/sesion-4/foto-1.svg",
    alt: "Verificación del candado de seguridad HTTPS en la barra de direcciones del navegador web.",
    descripcion:
      "Inspección de enlaces y verificación del candado de navegación segura antes de ingresar información.",
    etiqueta: "Cuadro 1 — Verificación de enlaces web",
  },
  {
    src: "/assets/sesion-4/foto-2.svg",
    alt: "Práctica de búsqueda en internet reconociendo resultados confiables y diferenciándolos de publicidad.",
    descripcion:
      "Uso de buscadores en internet para localizar información oficial y citas médicas evitando anuncios engañosos.",
