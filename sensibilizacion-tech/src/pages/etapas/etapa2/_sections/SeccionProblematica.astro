---
/* ============================================================
   ENTRADA 2 (parte 1) — Problemática y contexto
   ============================================================
   Cubre estos puntos de la segunda entrada del blog:
     · Título breve y llamativo de la entrada -> vive en el <h1>
       de src/pages/etapas/etapa2/index.astro, no aquí.
     · Problemática a abordar + breve descripción.
     · Contextualización del territorio o comunidad.
     · Fotografías y geolocalización del territorio.

   CÓMO COMPLETAR LAS FOTOS:
   copiar cada imagen a  public/assets/territorio/  y en el arreglo
   FOTOS de abajo poner esa ruta en `src`, junto con su `alt` (qué
   se ve, para quien no puede ver la imagen) y su `descripcion`
   (el pie de foto, que es parte del entregable). Mientras `src`
   sea null, se sigue mostrando el marcador punteado.

   LOS MAPAS YA ESTÁN PUESTOS:
   se renderizan con <MapaUbicacion>, un mapa por lugar. Para
   agregar, quitar o mover un punto se edita la lista UBICACIONES
   de abajo — nunca se copia un iframe a mano.
   ============================================================ */
import SeccionBase from "../../../../components/SeccionBase.astro";
import TextoPendiente from "../../../../components/TextoPendiente.astro";
import MapaUbicacion from "../../../../components/MapaUbicacion.astro";

interface Foto {
  /** Ruta pública de la imagen. null = todavía se muestra el marcador punteado. */
  readonly src: string | null;
  /** Texto alternativo para quien no puede ver la imagen — describe lo que se ve. */
  readonly alt: string;
  /** Pie de foto visible debajo de la imagen. */
  readonly descripcion: string;
}

const FOTOS: readonly Foto[] = [
  {
    src: "/assets/territorio/fotos-territorio-1.jpeg",
    // TODO: ajustar el alt y el pie de foto con el lugar y las personas exactas
    // (¿La Plata, Huila o San Cristóbal, Medellín? ¿quiénes aparecen?).
    alt: "Dos personas posando en un mirador, con un pueblo entre montañas de fondo.",
    descripcion: "Vista del territorio donde se desarrolla la práctica.",
  },
  {
    src: "/assets/territorio/fotos-territorio-2.jpeg",
    // TODO: confirmar de quién es este escritorio y ajustar el pie de foto.
    alt: "Escritorio con un computador portátil y un monitor externo, junto a una ventana con vista a un pueblo de techos de teja.",
    descripcion: "El espacio desde donde se acompañan las sesiones virtuales.",
  },
  {
    src: null,
    alt: "",
    descripcion: "Fotografía 3 — un momento del acercamiento con la comunidad.",
  },
];

/**
 * Territorios donde se desarrolla la práctica. Fuente única de los mapas:
 * agregar un lugar aquí lo agrega a la grilla; no hay iframes sueltos.
 *
 * La coordenada de La Plata venía en grados-minutos-segundos
 * (2°23'07.6"N 75°53'59.3"W) y se convirtió a grados decimales, que es
 * lo que consume la API de mapas.
 */
const UBICACIONES = [
  { titulo: "La Plata, Huila", lat: 2.385444, lng: -75.899806 },
  { titulo: "San Cristóbal, Medellín, Antioquia", lat: 6.278388, lng: -75.624144 },
] as const;
---

<SeccionBase
  id="problematica"
  titulo=""
  descripcion=""
  fondo="alt"
>
  <div class="flex flex-col gap-lg">
    <!-- ---------- Problemática ---------- -->
    <article class="card border border-line">
      <h3>La problemática que abordamos</h3>
      <div class="mt-sm flex flex-col gap-sm">
        <p>
          En el marco del macroproyecto "Conectando el futuro: Inclusión digital",
          mediante la iniciativa comunitaria Puente Digital, se identifican dos
          problemáticas relacionadas con las necesidades de formación de las cuatro
          personas adultas participantes de La Plata, Huila, y San Cristóbal,
          Medellín, Antioquia:
        </p>
        <ul class="list-disc pl-md">
          <li>
            <strong>Conocimientos limitados sobre el manejo de dispositivos electrónicos:</strong>
            necesidad de fortalecer las habilidades para utilizar las funciones del celular,
            comunicarse, consultar información y gestionar documentos con mayor autonomía.
          </li>
          <li>
            <strong>Vulnerabilidad ante estafas por desconocimiento del uso seguro de dispositivos electrónicos:</strong>
            necesidad de desarrollar criterios para reconocer comunicaciones sospechosas,
            verificar solicitudes y proteger cuentas e información personal.
          </li>
        </ul>
      </div>
    </article>

    <!-- ---------- Contextualización del territorio ---------- -->
    <article class="card border border-line">
      <h3>El territorio y la comunidad</h3>
      <div class="mt-sm flex flex-col gap-sm">
        <p>
          Cuatro personas adultas, padres de Brando y Sebastián, residentes en Huila
          y Antioquia, de acuerdo con la Entrada 1 del blog. La portada del blog
          orienta la iniciativa a personas mayores; no se proporcionan edades
          individuales. No se atribuye a todo el grupo una categoría etaria sin
          verificarla.
        </p>
      </div>
    </article>

    <!-- ---------- Fotografías ---------- -->
    <article>
      <h3>Fotografías del territorio</h3>
      <ul class="mt-md grid grid-cols-1 gap-md sm:grid-cols-2 lg:grid-cols-3">
        {
          FOTOS.map((foto) => (
            <li>
              <figure>
                {foto.src ? (
                  <img
                    src={foto.src}
                    alt={foto.alt}
                    class="aspect-video w-full rounded-md object-cover"
                  />
                ) : (
                  <div
                    class="flex aspect-video w-full items-center justify-center rounded-md border-2 border-dashed border-line bg-bg"
                    aria-hidden="true"
                  >
                    <svg
                      class="size-12 text-line"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <rect x="3" y="5" width="18" height="14" rx="2" />
                      <circle cx="9" cy="10" r="1.5" />
                      <path d="m4 17 5-5 4 4 3-2 4 4" />
                    </svg>
                  </div>
                )}
                <figcaption class="mt-sm text-sm text-text-muted">{foto.descripcion}</figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </article>

    <!-- ---------- Geolocalización ---------- -->
    <article>
      <h3>Geolocalización</h3>
      <p class="mt-xs text-sm text-text-muted">
        Ubicación exacta de los territorios donde se desarrolla la práctica.
      </p>

      <ul class="mt-md grid grid-cols-1 gap-md lg:grid-cols-2">
        {
          UBICACIONES.map((ubicacion) => (
            <li>
              <MapaUbicacion lat={ubicacion.lat} lng={ubicacion.lng} titulo={ubicacion.titulo} />
            </li>
          ))
        }
      </ul>
    </article>
  </div>
</SeccionBase>
