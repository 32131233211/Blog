---
/* ============================================================
   ENTRADA 2 (parte 3) — Justificación y referencias
   ============================================================
   · Justificación: argumentos claros y contundentes sobre la
     problemática abordada, el carácter académico, científico y
     social del proyecto, y los aportes a la comunidad.
   · Referencias: fuentes utilizadas, en normas APA.

   CÓMO COMPLETAR LAS REFERENCIAS: escribir cada fuente completa
   en el arreglo REFERENCIAS, ya formateada en APA. Si la fuente
   tiene enlace, ponerlo en `url` y se renderiza como link.
   ============================================================ */
import SeccionBase from "../../../../components/SeccionBase.astro";
import TextoPendiente from "../../../../components/TextoPendiente.astro";

const JUSTIFICACION: readonly string[] = [
  "El uso de dispositivos electrónicos, especialmente los teléfonos celulares, se ha convertido en una herramienta fundamental para la comunicación en el día a día, el acceso a la información y la realización de diferentes actividades de la vida cotidiana. Sin embargo, no todas las personas cuentan con los conocimientos y habilidades necesarias para utilizar estas tecnologías de manera adecuada, lo que puede generar dificultades para realizar acciones básicas como comunicarse mediante aplicaciones, utilizar el correo electrónico, descargar documentos o navegar por Internet.",
  "A esta situación se suma la probabilidad de posibles riesgos asociados al uso de herramientas digitales. El desconocimiento sobre prácticas de seguridad puede hacer que las personas sean más vulnerables ante estafas, mensajes fraudulentos, enlaces maliciosos, aplicaciones inseguras o el uso inadecuado de contraseñas. Por esta razón, adquirir conocimientos básicos sobre el manejo y la seguridad de los dispositivos electrónicos es importante para aprovechar sus beneficios y reducir los riesgos durante su utilización.",
  "Este proyecto busca contribuir a solucionar estos problemas mediante un proceso de capacitaciones. Durante este proceso se abordarán temas relacionados con el reconocimiento y manejo del celular, las herramientas de comunicación digital, las pautas de seguridad y la navegación responsable en Internet. De esta manera, se pretende que los participantes desarrollen mayor confianza y autonomía en el uso de sus dispositivos, al mismo tiempo que adquieren herramientas para identificar y prevenir posibles situaciones de riesgo digital.",
];

interface Referencia {
  /** Cita completa en normas APA. */
  readonly cita: string;
  /** URL o DOI de la fuente, si aplica. */
  readonly url?: string;
  readonly pendiente?: boolean;
}

const REFERENCIAS: readonly Referencia[] = [
  {
    cita:
      "Pacheco Duarte, J. F. et al. (2022). Ruta de Innovación Social: Paso a paso para desarrollar innovaciones sociales (Documento Técnico 02). Corporación Universitaria Minuto de Dios.",
  },
  {
    cita:
      "Reyna Cruz, W. E., Carreón Corona, A. L. & Armijo Mena, S. G. (2019). La interrelación de diferentes disciplinas para el abordaje científico de fenómenos y problemas sociales. Revista Latinoamericana de Metodología de las Ciencias Sociales, 9(2).",
  },
];

const ENLACES_REFERENCIAS = [
  { titulo: "Guía multidimensional", url: "https://uniminuto0-my.sharepoint.com/:w:/g/personal/yeimy_calle_uniminuto_edu_co/IQBiZ78h2xZFR7e5hlJgLJYOAX1tLQ9WsZ_Qdm-pEj_rHvg?e=9S4sJM" },
  { titulo: "Plan de trabajo", url: "https://uniminuto0-my.sharepoint.com/:w:/g/personal/yeimy_calle_uniminuto_edu_co/IQBiZ78h2xZFR7e5hlJgLJYOAX1tLQ9WsZ_Qdm-pEj_rHvg?e=9S4sJM" },
] as const;
---

<SeccionBase
  id="justificacion"
  titulo="Justificación"
  descripcion=""
  fondo="alt"
>
  <div class="flex flex-col gap-lg">
    <!-- ---------- Justificación ---------- -->
    <article class="card border border-line">
      <div class="flex flex-col gap-sm">
        {JUSTIFICACION.map((parrafo) => <p class="text-text-muted">{parrafo}</p>)}
      </div>
    </article>

    <!-- ---------- Referencias ---------- -->
    <article>
      <h3>Referencias</h3>

      <ul class="mt-md flex flex-col gap-sm">
        {
          REFERENCIAS.map((referencia) => (
            <li class="border-l-4 border-line pl-sm">
              {referencia.pendiente ? (
                <p class="text-sm text-text-muted italic">
                  <span class="sr-only">Referencia pendiente: </span>
                  {referencia.cita}
                </p>
              ) : (
                <p class="text-sm">
                  {referencia.cita}
                  {referencia.url && (
                    <>
                      {" "}
                      <a href={referencia.url} target="_blank" rel="noopener noreferrer">
                        {referencia.url}
                        <span class="sr-only"> (se abre en una pestaña nueva)</span>
                      </a>
                    </>
                  )}
                </p>
              )}
            </li>
          ))
        }
      </ul>

      <div class="mt-md grid grid-cols-1 gap-sm sm:grid-cols-2">
        {
          ENLACES_REFERENCIAS.map((enlace) => (
            <a
              href={enlace.url || undefined}
              target={enlace.url ? "_blank" : undefined}
              rel={enlace.url ? "noopener noreferrer" : undefined}
              aria-disabled={!enlace.url}
              class:list={[
                "flex min-h-11 items-center justify-center rounded-sm border border-primary px-sm py-xs text-center font-medium no-underline",
                enlace.url
                  ? "bg-primary text-white hover:bg-primary-600"
                  : "cursor-not-allowed bg-primary-50 text-primary-800",
              ]}
            >
              {enlace.titulo}
            </a>
          ))
        }
      </div>
    </article>
  </div>
</SeccionBase>
