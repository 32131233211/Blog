---

<SeccionBase
  id="evidencias-capacitaciones"
  titulo="Evidencia y descripción de las capacitaciones"
  descripcion=""
  fondo="alt"
>
  <!-- Contenedor principal de dos columnas: Izquierda = Capacitación 3 | Derecha = Capacitación 4 -->
  <div class="grid grid-cols-1 gap-lg lg:grid-cols-2 lg:gap-xl">
    <!-- ============================================================
         COLUMNA IZQUIERDA: CAPACITACIÓN 3
         ============================================================ -->
    <article class="flex flex-col">
      <header class="border-b border-line pb-sm">
        <p class="text-xs font-semibold tracking-wider text-primary uppercase">
          Capacitación 3 — Sesión práctica
        </p>
        <h3 class="mt-xs text-xl text-text">Pautas de seguridad digital</h3>
        <p class="mt-xs text-sm text-text-muted">
          <strong>&bull; Facilitador:</strong> Sebastián Corrales Sepúlveda <br
          />
          &bull;
          <strong> Enfoque:</strong> SMS, correo electrónico, contraseñas, MFA y apps
          seguras.
        </p>
        <div class="mt-sm rounded-sm bg-bg p-sm border border-line">
          <p class="text-sm text-text-muted">
            <strong>Descripción de la sesión:</strong> Con la participación de Christian
            García, Glory Ariza, Fabiola Sepúlveda y Alcides Corrales, en esta sesión
            se abordaron pautas fundamentales para protegerse de fraudes digitales
            cotidianos. Se identificaron mensajes SMS sospechosos (smishing), correos
            fraudulentos (phishing), la creación de contraseñas robustas pero fáciles
            de recordar mediante frases clave, la activación y uso de la autenticación
            multifactor (MFA) y la descarga segura de aplicaciones desde tiendas oficiales
            como Google Play Store. Al cierre se realizó una evaluación diagnóstica
            participativa.
          </p>
        </div>
      </header>

      <!-- Cuadrícula interna de 6 cuadros (3 filas x 2 columnas) -->
      <ul class="mt-md grid grid-cols-2 gap-sm sm:gap-md" role="list">
        {
          FOTOS_CAPACITACION_3.map((foto) => (
            <li class="flex flex-col">
              <figure class="flex h-full flex-col">
                {foto.src ? (
                  <button
                    type="button"
                    class="group block w-full cursor-zoom-in overflow-hidden rounded-md border border-line"
                    data-lightbox-trigger
                    data-lightbox-src={foto.src}
                    data-lightbox-alt={foto.alt}
                    data-lightbox-caption={foto.descripcion}
                    aria-label={`Ampliar imagen: ${foto.descripcion}`}
                  >
                    <img
                      src={foto.src}
                      alt={foto.alt}
                      class={`aspect-4/3 w-full transition-transform duration-200 group-hover:scale-105 ${foto.ajuste === "contain" ? "object-contain bg-bg-alt p-xs" : "object-cover"}`}
                      loading="lazy"
                    />
                  </button>
                ) : (
                  <div
                    class="flex aspect-4/3 w-full flex-col items-center justify-center rounded-md border-2 border-dashed border-line bg-bg p-xs text-center transition-colors hover:border-primary-400"
                    aria-label={foto.etiqueta}
                  >
                    <svg
                      class="size-8 text-line sm:size-10"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <rect x="3" y="5" width="18" height="14" rx="2" />
                      <circle cx="9" cy="10" r="1.5" />
                      <path d="m4 17 5-5 4 4 3-2 4 4" />
                    </svg>
                    <span class="mt-xs text-xs font-medium text-text-muted line-clamp-1">
                      {foto.etiqueta}
                    </span>
                  </div>
                )}
                <figcaption class="mt-xs text-xs sm:text-sm text-text-muted">
                  {foto.descripcion}
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </article>

    <!-- ============================================================
         COLUMNA DERECHA: CAPACITACIÓN 4
         ============================================================ -->
    <article class="flex flex-col">
      <header class="border-b border-line pb-sm">
        <p
          class="text-xs font-semibold tracking-wider text-secondary uppercase"
        >
          Capacitación 4 — Sesión práctica
        </p>
        <h3 class="mt-xs text-xl text-text">
          Enlaces seguros, documentos y apps de trámites
        </h3>
        <p class="mt-xs text-sm text-text-muted">
          <strong>&bull; Facilitador:</strong> Yeimi Liliana Calle Calvo <br />
          &bull;
          <strong> Enfoque:</strong> Verificación de enlaces, descarga de documentos
          y aplicaciones de trámites cotidianos.
        </p>
        <div class="mt-sm rounded-sm bg-bg p-sm border border-line">
          <p class="text-sm text-text-muted">
            <strong>Descripción de la evidencia:</strong> Con la participación
            de Christian García, Glory Ariza, Fabiola Sepúlveda y Alcides Corrales,
            en esta cuarta jornada se siguió la sesión por videollamada, con el
            apoyo de un tutor en casa y la práctica directa en el propio celular.
            Se explicó cómo verificar un enlace antes de compartirlo o abrirlo y se
            practicó la descarga de una copia de factura de servicios públicos.
            Después se recorrieron aplicaciones de uso cotidiano para realizar
            trámites desde el celular: una aplicación bancaria con su menú de
            transacciones, una aplicación de salud para agendar citas y consultar
            resultados de exámenes, y una aplicación de pagos con sus servicios
            y categorías.
          </p>
        </div>
      </header>

      <!-- Cuadrícula interna de 6 cuadros (3 filas x 2 columnas) -->
      <ul class="mt-md grid grid-cols-2 gap-sm sm:gap-md" role="list">
        {
          FOTOS_CAPACITACION_4.map((foto) => (
            <li class="flex flex-col">
              <figure class="flex h-full flex-col">
                {foto.src ? (
                  <button
                    type="button"
                    class="group block w-full cursor-zoom-in overflow-hidden rounded-md border border-line"
                    data-lightbox-trigger
                    data-lightbox-src={foto.src}
                    data-lightbox-alt={foto.alt}
                    data-lightbox-caption={foto.descripcion}
                    aria-label={`Ampliar imagen: ${foto.descripcion}`}
                  >
                    <img
                      src={foto.src}
                      alt={foto.alt}
                      class={`aspect-4/3 w-full transition-transform duration-200 group-hover:scale-105 ${foto.ajuste === "contain" ? "object-contain bg-bg-alt p-xs" : "object-cover"}`}
                      loading="lazy"
                    />
                  </button>
                ) : (
                  <div
                    class="flex aspect-4/3 w-full flex-col items-center justify-center rounded-md border-2 border-dashed border-line bg-bg p-xs text-center transition-colors hover:border-primary-400"
                    aria-label={foto.etiqueta}
                  >
                    <svg
                      class="size-8 text-line sm:size-10"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <rect x="3" y="5" width="18" height="14" rx="2" />
                      <circle cx="9" cy="10" r="1.5" />
                      <path d="m4 17 5-5 4 4 3-2 4 4" />
                    </svg>
                    <span class="mt-xs text-xs font-medium text-text-muted line-clamp-1">
                      {foto.etiqueta}
                    </span>
                  </div>
                )}
                <figcaption class="mt-xs text-xs sm:text-sm text-text-muted">
                  {foto.descripcion}
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </article>
  </div>
</SeccionBase>

<!-- ============================================================
     LIGHTBOX — visor de imagen ampliada, compartido por ambas
     columnas. Se activa desde los botones con [data-lightbox-trigger].
     ============================================================ -->
<dialog
  id="lightbox-evidencias"
  class="m-auto w-[min(92vw,56rem)] max-h-[90vh] rounded-lg border border-line bg-bg p-0 open:flex open:flex-col"
>
  <div
    class="flex items-center justify-between gap-sm border-b border-line p-sm"
  >
    <p id="lightbox-caption" class="text-sm text-text-muted pr-sm">&nbsp;</p>
    <button
      type="button"
      id="lightbox-cerrar"
      class="flex size-11 shrink-0 items-center justify-center rounded-sm text-text hover:bg-bg-alt"
      aria-label="Cerrar imagen ampliada"
    >
      <svg
        class="size-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M18 6 6 18"></path>
        <path d="m6 6 12 12"></path>
      </svg>
    </button>
  </div>
  <div class="flex-1 overflow-auto p-sm">
    <img
      id="lightbox-imagen"
      src=""
      alt=""
      class="mx-auto max-h-[75vh] w-auto rounded-sm object-contain"
    />
  </div>
</dialog>

<script>
  const dialogo = document.querySelector<HTMLDialogElement>(
    "#lightbox-evidencias",
  );
  const imagen = document.querySelector<HTMLImageElement>("#lightbox-imagen");
  const leyenda =
    document.querySelector<HTMLParagraphElement>("#lightbox-caption");
  const botonCerrar =
    document.querySelector<HTMLButtonElement>("#lightbox-cerrar");

  if (dialogo && imagen && leyenda && botonCerrar) {
    document
      .querySelectorAll<HTMLButtonElement>("[data-lightbox-trigger]")
      .forEach((boton) => {
        boton.addEventListener("click", () => {
          const src = boton.dataset.lightboxSrc ?? "";
          imagen.src = src;
          imagen.alt = boton.dataset.lightboxAlt ?? "";
          leyenda.textContent = boton.dataset.lightboxCaption ?? "";
          dialogo.showModal();
        });
      });

    botonCerrar.addEventListener("click", () => dialogo.close());

    // Cerrar al hacer clic sobre el fondo (fuera del contenido del diálogo)
    dialogo.addEventListener("click", (evento) => {
      if (evento.target === dialogo) {
        dialogo.close();
      }
    });

    dialogo.addEventListener("close", () => {
      imagen.src = "";
    });
  }
</script>

<style>
  #lightbox-evidencias::backdrop {
    background-color: rgb(40 40 40 / 80%);
  }
</style>
