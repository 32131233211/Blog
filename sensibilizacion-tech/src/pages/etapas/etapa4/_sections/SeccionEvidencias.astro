---
/* ============================================================
   ENTRADA 4 (parte 2) — Evidencia (fotos) y Descripción
   ============================================================
   Estructura simétrica de dos columnas principales:
     · Columna Izquierda: Capacitación 3 (Pautas de seguridad digital).
     · Columna Derecha: Capacitación 4 (Navegación segura y organización).

   Cada columna contiene una cuadrícula idéntica de 6 cuadros de
   imagen distribuidos en 3 filas (2 cuadros por fila):
     - Fila 1: Cuadros 1 y 2
     - Fila 2: Cuadros 3 y 4
     - Fila 3: Cuadros 5 y 6

   CÓMO ASIGNAR FOTOS REALES:
   Colocar los archivos en public/assets/sesion-3/ y public/assets/sesion-4/
   (o ruta pública), y reemplazar la ruta en `src` correspondiente
   (ej. "/assets/sesion-3/foto-1.jpeg"), ajustando también el texto
   descriptivo de `alt` y `descripcion`.

   AJUSTE DE ENCUADRE (`ajuste`):
   Por defecto la imagen llena el recuadro 4:3 recortando sobrante
   (ideal para fotos horizontales). Para capturas de pantalla del
   celular (verticales), agregar `ajuste: "contain"` para mostrarlas
   completas sin recortar, con relleno a los lados en vez de perder
   contenido.
   ============================================================ */
import SeccionBase from "../../../../components/SeccionBase.astro";

interface FotoEvidencia {
  /** Ruta pública del archivo de imagen. Si es null, renderiza el cuadro de reserva punteado. */
  readonly src: string | null;
  /** Texto alternativo accesible que describe el contenido de la imagen. */
  readonly alt: string;
  /** Pie de foto o descripción detallada de la evidencia. */
  readonly descripcion: string;
  /** Etiqueta indicativa del cuadro mientras esté pendiente de imagen. */
  readonly etiqueta: string;
  /**
   * Cómo encajar la imagen dentro del recuadro 4:3.
   * "cover" (por defecto): llena el recuadro recortando sobrante — ideal para fotos horizontales.
   * "contain": muestra la imagen completa sin recortar, con relleno a los lados —
   * usar en capturas de pantalla verticales, donde recortar perdería contenido relevante.
   */
  readonly ajuste?: "cover" | "contain";
}

/* ------------------------------------------------------------
   COLUMNA IZQUIERDA: CAPACITACIÓN 3 (6 cuadros en 3 filas de 2)
   Facilitador: Sebastián Corrales Sepúlveda | Temática: Pautas de seguridad digital
   ------------------------------------------------------------ */
const FOTOS_CAPACITACION_3: readonly FotoEvidencia[] = [
  // Fila 1 (2 cuadros)
  {
    src: "/assets/sesion-3/Foto1.png",
