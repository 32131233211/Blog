---
/* ============================================================
   ENTRADA 3 (parte 1) — Descripción general de la capacitación
   ============================================================
   Presenta el contexto, objetivos y dinámica general de las
   sesiones de capacitación realizadas en el marco de Puente
   Digital (Sabios Digitales).

   CÓMO COMPLETAR:
   Editar los párrafos en el arreglo DESCRIPCION_GENERAL de abajo.
   Si se requiere agregar más párrafos, basta con añadir elementos
   a la lista.
   ============================================================ */
import SeccionBase from "../../../../components/SeccionBase.astro";

const DESCRIPCION_GENERAL: readonly string[] = [
  "En el marco del proyecto social Puente Digital y su programa Sabios Digitales, se dio inicio al ciclo de capacitaciones prácticas de alfabetización digital y uso seguro de dispositivos móviles, orientado a personas adultas mayores residentes en La Plata (Huila) y San Cristóbal (Medellín, Antioquia).",
  "Durante esta etapa se llevaron a cabo las dos primeras sesiones formativas: la Capacitación 1, centrada en el reconocimiento de interfaces, símbolos y funcionalidades básicas del teléfono celular; y la Capacitación 2, enfocada en herramientas clave de comunicación cotidiana como WhatsApp, llamadas, videollamadas y correo electrónico.",
  "Las sesiones se desarrollaron bajo una metodología virtual y participativa, complementada con el acompañamiento presencial y personalizado de los integrantes del equipo en cada hogar. Este esquema permitió resolver dudas puntuales al ritmo de cada participante, promoviendo un ambiente de confianza, paciencia y aprendizaje significativo.",
];
---

<SeccionBase
  id="descripcion-capacitacion"
  titulo="Descripción general de la capacitación"
  descripcion=""
  fondo="base"
>
  <div class="flex flex-col gap-lg">
    <article class="card border border-line">
      <div class="flex flex-col gap-sm">
        {
          DESCRIPCION_GENERAL.map((parrafo) => (
            <p class="text-text-muted">{parrafo}</p>
          ))
        }
      </div>
    </article>

    <!-- Resumen metodológico de apoyo -->
    <aside class="rounded-md border border-line bg-bg-alt p-md">
      <h3 class="text-lg font-medium text-text">Resumen metodológico de las sesiones</h3>
      <ul class="mt-sm grid grid-cols-1 gap-sm md:grid-cols-2">
        <li class="rounded-sm border border-line/60 bg-bg p-sm">
          <p class="font-medium text-primary-700">Modalidad combinada</p>
          <p class="mt-xs text-sm text-text-muted">
            Encuentros interactivos por videollamada con soporte directo de un tutor presencial al lado del adulto mayor.
          </p>
        </li>
        <li class="rounded-sm border border-line/60 bg-bg p-sm">
          <p class="font-medium text-primary-700">Ritmo adaptativo</p>
          <p class="mt-xs text-sm text-text-muted">
            Explicación paso a paso, repetición guiada y práctica directa en el propio dispositivo de cada participante.
          </p>
        </li>
      </ul>
    </aside>
  </div>
</SeccionBase>
