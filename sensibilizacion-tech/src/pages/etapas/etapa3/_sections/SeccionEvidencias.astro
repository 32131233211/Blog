---
/* ============================================================
   ENTRADA 3 (parte 2) — Evidencia (fotos) y Descripción
   ============================================================
   Estructura simétrica de dos columnas principales:
     · Columna Izquierda: Capacitación 1 (Reconocimiento del celular).
     · Columna Derecha: Capacitación 2 (Comunicaciones y apps).

   Cada columna contiene una cuadrícula idéntica de 6 cuadros de
   imagen distribuidos en 3 filas (2 cuadros por fila):
     - Fila 1: Cuadros 1 y 2
     - Fila 2: Cuadros 3 y 4
     - Fila 3: Cuadros 5 y 6

   CÓMO ASIGNAR FOTOS REALES:
   Colocar los archivos en public/assets/evidencias/ (o ruta pública),
   y reemplazar `src: null` por la ruta correspondiente (ej. "/assets/evidencias/foto1.jpg"),
   ajustando también el texto descriptivo de `alt` y `descripcion`.

   AJUSTE DE ENCUADRE (`ajuste`):
   Por defecto la imagen llena el recuadro 4:3 recortando sobrante
   (ideal para fotos horizontales). Para capturas de pantalla del
   celular (verticales), agregar `ajuste: "contain"` para mostrarlas
   completas sin recortar, con relleno a los lados en vez de perder
   contenido.
   ============================================================ */
import SeccionBase from "../../../../components/SeccionBase.astro";

interface FotoEvidencia {
  /** Ruta pública del archivo de imagen. Si es null, renderiza el cuadro de reserva punteado. */
  readonly src: string | null;
  /** Texto alternativo accesible que describe el contenido de la imagen. */
  readonly alt: string;
  /** Pie de foto o descripción detallada de la evidencia. */
  readonly descripcion: string;
  /** Etiqueta indicativa del cuadro mientras esté pendiente de imagen. */
  readonly etiqueta: string;
  /**
   * Cómo encajar la imagen dentro del recuadro 4:3.
   * "cover" (por defecto): llena el recuadro recortando sobrante — ideal para fotos horizontales.
   * "contain": muestra la imagen completa sin recortar, con relleno a los lados —
   * usar en capturas de pantalla verticales, donde recortar perdería contenido relevante.
   */
  readonly ajuste?: "cover" | "contain";
}

/* ------------------------------------------------------------
   COLUMNA DERECHA: CAPACITACIÓN 2 (6 cuadros en 3 filas de 2)
   Facilitador: Brando García | Temática: Comunicaciones
   ------------------------------------------------------------ */
const FOTOS_CAPACITACION_2: readonly FotoEvidencia[] = [
  // Fila 1 (2 cuadros)
  {
    src: '/assets/sesion-2/foto-1.jpeg',
    alt: "Demostración de la bandeja de entrada del correo electrónico y sus funciones principales.",
    descripcion: "Explicación de la bandeja de entrada del correo y sus funciones principales.",
    etiqueta: "Cuadro 1 — Bandeja de correo electrónico",
  },
  {
    src: '/assets/sesion-2/foto-2.jpeg',
    alt: "Demostración del envío de mensajes y notas de voz a través de WhatsApp.",
    descripcion:
      "Práctica de envío de mensajes, audios e imágenes por WhatsApp.",
    etiqueta: "Cuadro 2 — Mensajería instantánea",
  },
  // Fila 2 (2 cuadros)
  {
    src: '/assets/sesion-2/foto-3.jpeg',
    alt: "Participante realizando el cuestionario diagnóstico en el computador.",
    descripcion: "Participante resolviendo el cuestionario diagnóstico al inicio de la sesión.",
    etiqueta: "Cuadro 3 — Cuestionario diagnóstico",
  },
  {
    src: '/assets/sesion-2/foto-4.jpeg',
    alt: "Participante realizando el cuestionario final en el computador.",
    descripcion: "Participante resolviendo el cuestionario final de la sesión.",
    etiqueta: "Cuadro 4 — Cuestionario final",
  },
  // Fila 3 (2 cuadros)
  {
    src: '/assets/sesion-2/foto-5.jpeg',
    alt: "Participantes interactuando durante una videollamada.",
    descripcion: "Participantes interactuando durante la práctica de videollamada.",
    etiqueta: "Cuadro 5 — Videollamada",
  },
  {
    src: '/assets/sesion-2/foto-6.png',
    alt: "Geolocalización en Google Maps.",
    descripcion: "Explicación del uso de Google Maps para ubicación y geolocalización.",
    etiqueta: "Cuadro 6 — Google Maps y ubicación",
  },
];

/* ------------------------------------------------------------
   COLUMNA IZQUIERDA: CAPACITACIÓN 1 (6 cuadros en 3 filas de 2)
   Facilitador: Marlon Muñoz | Temática: Reconocimiento de celular
   ------------------------------------------------------------ */
const FOTOS_CAPACITACION_1: readonly FotoEvidencia[] = [
  {
    src: '/assets/sesion-1/foto-1.png',
    alt: "Explicación de los temas a tratar.",
    descripcion: "Bienvenida y presentación de los temas de la primera sesión.",
    etiqueta: "Cuadro 1 — Bienvenida y presentación de la sesión",
  },
  {
    src: '/assets/sesion-1/foto-2.png',
    alt: "Presentación de partes físicas del celular.",
    descripcion: "Presentación del celular y reconocimiento de sus partes físicas.",
    etiqueta: "Cuadro 2 — Partes físicas del celular",
  },
  {
    src: '/assets/sesion-1/foto-3.jpeg',
    alt: "Realización de encuesta de final de sesión.",
    descripcion: "Participante diligenciando la encuesta de satisfacción al cierre de la sesión.",
    etiqueta: "Cuadro 3 — Encuesta final de la sesión",
  },
  {
    src: '/assets/sesion-1/foto-4.jpeg',
    alt: "Participante realizando evaluación de conocimientos básicos en el celular.",
    descripcion: "Participante resolviendo la evaluación final de conocimientos básicos.",
    etiqueta: "Cuadro 4 — Evaluación de conocimientos básicos",
  },
  {
    src: '/assets/sesion-1/foto-5.jpeg',
    alt: "Interfaz de llamadas telefónicas.",
    descripcion: "Explicación de la interfaz de llamadas y sus símbolos principales.",
    etiqueta: "Cuadro 5 — Llamadas telefónicas",
    ajuste: "contain",
  },
  {
    src: '/assets/sesion-1/foto-6.jpeg',
    alt: "Presentación de interfaz básica del celular.",
    descripcion: "Presentación de la barra de estado del celular y sus símbolos.",
    etiqueta: "Cuadro 6 — Barra de estado y símbolos",
    ajuste: "contain",
  },
];
---

<SeccionBase
  id="evidencias-capacitaciones"
  titulo="Evidencia y descripción de las capacitaciones"
  descripcion=""
  fondo="alt"
>
  <!-- Contenedor principal de dos columnas: Izquierda = Capacitación 1 | Derecha = Capacitación 2 -->
  <div class="grid grid-cols-1 gap-lg lg:grid-cols-2 lg:gap-xl">
    <!-- ============================================================
         COLUMNA IZQUIERDA: CAPACITACIÓN 1
         ============================================================ -->
    <article class="flex flex-col">
      <header class="border-b border-line pb-sm">
        <p class="text-xs font-semibold tracking-wider text-primary uppercase">
          Capacitación 1 — Sesión práctica
        </p>
        <h3 class="mt-xs text-xl text-text">
          Reconocimiento de interfaces del celular
        </h3>
        <p class="mt-xs text-sm text-text-muted">
          <strong>&bull; Facilitador:</strong> Marlon Muñoz Romero <br>
          &bull; 
          <strong> Enfoque:</strong> Interfaces, símbolos, llamadas y apps básicas.
        </p>
        <div class="mt-sm rounded-sm bg-bg p-sm border border-line">
          <p class="text-sm text-text-muted">
            <strong>Descripción de la sesión:</strong> Con la participación de Christian García, Glory Ariza y Fabiola Sepúlveda, en esta sesión se exploraron las partes físicas que hacen parte del dispositivo móvil, la interfaz básica, la barra de estado y sus símbolos, los gestos táctiles, cómo hacer llamadas, reconocimiento de los símbolos de la llamada, envío de SMS y tips de seguridad para el uso del dispositivo. Al final se realizó un cuestionario de conocimientos básicos para evaluar el aprendizaje de los participantes.
          </p>
        </div>
      </header>

      <!-- Cuadrícula interna de 6 cuadros (3 filas x 2 columnas) -->
      <ul class="mt-md grid grid-cols-2 gap-sm sm:gap-md" role="list">
        {
          FOTOS_CAPACITACION_1.map((foto) => (
            <li class="flex flex-col">
              <figure class="flex h-full flex-col">
                {foto.src ? (
                  <button
                    type="button"
                    class="group block w-full cursor-zoom-in overflow-hidden rounded-md border border-line"
                    data-lightbox-trigger
                    data-lightbox-src={foto.src}
                    data-lightbox-alt={foto.alt}
                    data-lightbox-caption={foto.descripcion}
                    aria-label={`Ampliar imagen: ${foto.descripcion}`}
                  >
                    <img
                      src={foto.src}
                      alt={foto.alt}
                      class={`aspect-4/3 w-full transition-transform duration-200 group-hover:scale-105 ${foto.ajuste === "contain" ? "object-contain bg-bg-alt p-xs" : "object-cover"}`}
                      loading="lazy"
                    />
                  </button>
                ) : (
                  <div
                    class="flex aspect-4/3 w-full flex-col items-center justify-center rounded-md border-2 border-dashed border-line bg-bg p-xs text-center transition-colors hover:border-primary-400"
                    aria-label={foto.etiqueta}
                  >
                    <svg
                      class="size-8 text-line sm:size-10"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <rect x="3" y="5" width="18" height="14" rx="2" />
                      <circle cx="9" cy="10" r="1.5" />
                      <path d="m4 17 5-5 4 4 3-2 4 4" />
                    </svg>
                    <span class="mt-xs text-xs font-medium text-text-muted line-clamp-1">
                      {foto.etiqueta}
                    </span>
                  </div>
                )}
                <figcaption class="mt-xs text-xs sm:text-sm text-text-muted">
                  {foto.descripcion}
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </article>

    <!-- ============================================================
         COLUMNA DERECHA: CAPACITACIÓN 2
         ============================================================ -->
    <article class="flex flex-col">
      <header class="border-b border-line pb-sm">
        <p
          class="text-xs font-semibold tracking-wider text-secondary uppercase"
        >
          Capacitación 2 — Sesión práctica
        </p>
        <h3 class="mt-xs text-xl text-text">
          Herramientas de comunicación digital
        </h3>
        <p class="mt-xs text-sm text-text-muted">
          <strong>&bull; Facilitador:</strong> Brando García Ariza <br>
          &bull;
          <strong> Enfoque:</strong
          > WhatsApp, videollamadas, correo y ubicación.
        </p>
        <div class="mt-sm rounded-sm bg-bg p-sm border border-line">
          <p class="text-sm text-text-muted">
            <strong>Descripción de la evidencia:</strong> Con la participación de Christian García, Glory Ariza, Fabiola Sepúlveda y Alcides Corrales, en esta sesión se exploraron herramientas de comunicación digital como WhatsApp, videollamadas, correo electrónico, aplicaciones de mapas y de escaneo de documentos. Se evidenció la interacción práctica de los participantes a partir de un examen diagnóstico al comienzo de la sesión y de un examen al final de la misma para evaluar el aprendizaje de la información compartida.
          </p>
        </div>
      </header>

      <!-- Cuadrícula interna de 6 cuadros (3 filas x 2 columnas) -->
      <ul class="mt-md grid grid-cols-2 gap-sm sm:gap-md" role="list">
        {
          FOTOS_CAPACITACION_2.map((foto) => (
            <li class="flex flex-col">
              <figure class="flex h-full flex-col">
                {foto.src ? (
                  <button
                    type="button"
                    class="group block w-full cursor-zoom-in overflow-hidden rounded-md border border-line"
                    data-lightbox-trigger
                    data-lightbox-src={foto.src}
                    data-lightbox-alt={foto.alt}
                    data-lightbox-caption={foto.descripcion}
                    aria-label={`Ampliar imagen: ${foto.descripcion}`}
                  >
                    <img
                      src={foto.src}
                      alt={foto.alt}
                      class={`aspect-4/3 w-full transition-transform duration-200 group-hover:scale-105 ${foto.ajuste === "contain" ? "object-contain bg-bg-alt p-xs" : "object-cover"}`}
                      loading="lazy"
                    />
                  </button>
                ) : (
                  <div
                    class="flex aspect-4/3 w-full flex-col items-center justify-center rounded-md border-2 border-dashed border-line bg-bg p-xs text-center transition-colors hover:border-primary-400"
                    aria-label={foto.etiqueta}
                  >
                    <svg
                      class="size-8 text-line sm:size-10"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <rect x="3" y="5" width="18" height="14" rx="2" />
                      <circle cx="9" cy="10" r="1.5" />
                      <path d="m4 17 5-5 4 4 3-2 4 4" />
                    </svg>
                    <span class="mt-xs text-xs font-medium text-text-muted line-clamp-1">
                      {foto.etiqueta}
                    </span>
                  </div>
                )}
                <figcaption class="mt-xs text-xs sm:text-sm text-text-muted">
                  {foto.descripcion}
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </article>
  </div>
</SeccionBase>

<!-- ============================================================
     LIGHTBOX — visor de imagen ampliada, compartido por ambas
     columnas. Se activa desde los botones con [data-lightbox-trigger].
     ============================================================ -->
<dialog
  id="lightbox-evidencias"
  class="m-auto w-[min(92vw,56rem)] max-h-[90vh] rounded-lg border border-line bg-bg p-0 open:flex open:flex-col"
>
  <div class="flex items-center justify-between gap-sm border-b border-line p-sm">
    <p id="lightbox-caption" class="text-sm text-text-muted pr-sm">
      &nbsp;
    </p>
    <button
      type="button"
      id="lightbox-cerrar"
      class="flex size-11 shrink-0 items-center justify-center rounded-sm text-text hover:bg-bg-alt"
      aria-label="Cerrar imagen ampliada"
    >
      <svg
        class="size-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M18 6 6 18" />
        <path d="m6 6 12 12" />
      </svg>
    </button>
  </div>
  <div class="flex-1 overflow-auto p-sm">
    <img
      id="lightbox-imagen"
      src=""
      alt=""
      class="mx-auto max-h-[75vh] w-auto rounded-sm object-contain"
    />
  </div>
</dialog>

<script>
  const dialogo = document.querySelector<HTMLDialogElement>(
    "#lightbox-evidencias",
  );
  const imagen = document.querySelector<HTMLImageElement>(
    "#lightbox-imagen",
  );
  const leyenda = document.querySelector<HTMLParagraphElement>(
    "#lightbox-caption",
  );
  const botonCerrar = document.querySelector<HTMLButtonElement>(
    "#lightbox-cerrar",
  );

  if (dialogo && imagen && leyenda && botonCerrar) {
    document
      .querySelectorAll<HTMLButtonElement>("[data-lightbox-trigger]")
      .forEach((boton) => {
        boton.addEventListener("click", () => {
          const src = boton.dataset.lightboxSrc ?? "";
          imagen.src = src;
          imagen.alt = boton.dataset.lightboxAlt ?? "";
          leyenda.textContent = boton.dataset.lightboxCaption ?? "";
          dialogo.showModal();
        });
      });

    botonCerrar.addEventListener("click", () => dialogo.close());

    // Cerrar al hacer clic sobre el fondo (fuera del contenido del diálogo)
    dialogo.addEventListener("click", (evento) => {
      if (evento.target === dialogo) {
        dialogo.close();
      }
    });

    dialogo.addEventListener("close", () => {
      imagen.src = "";
    });
  }
</script>

<style>
  #lightbox-evidencias::backdrop {
    background-color: rgb(40 40 40 / 80%);
  }
</style>
