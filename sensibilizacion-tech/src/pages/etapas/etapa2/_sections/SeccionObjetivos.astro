---
/* ============================================================
   ENTRADA 2 (parte 2) — Objetivos
   ============================================================
   Objetivo general (relacionado con el tema y el territorio) y
   objetivos específicos, que marcan de forma SECUENCIAL las
   etapas del proyecto. Mínimo 3 objetivos específicos.

   CÓMO COMPLETAR: escribir cada objetivo en el arreglo
   OBJETIVOS_ESPECIFICOS. Agregar más elementos si se necesitan;
   la numeración se recalcula sola.
   ============================================================ */
import SeccionBase from "../../../../components/SeccionBase.astro";
import TextoPendiente from "../../../../components/TextoPendiente.astro";

interface Objetivo {
  /** Texto definitivo, o la guía de qué debe escribirse mientras esté pendiente. */
  readonly texto: string;
  readonly pendiente?: boolean;
}

const OBJETIVOS_ESPECIFICOS: readonly Objetivo[] = [
  {
    texto: "Primera Entradadel proyecto: qué se hace primero y con qué propósito.",
    pendiente: true,
  },
  {
    texto: "Segunda etapa: qué se desarrolla a partir del resultado de la anterior.",
    pendiente: true,
  },
  {
    texto: "Tercera etapa: cómo se cierra el proceso y se verifica el aprendizaje logrado.",
    pendiente: true,
  },
];
---

<SeccionBase
  id="objetivos"
  titulo="Objetivos"
  descripcion="Lo que buscamos alcanzar con el Proyecto Social de Formación."
>
  <div class="flex flex-col gap-lg">
    <!-- ---------- Objetivo general ---------- -->
    <article class="card border-l-4 border-primary bg-primary-50">
      <h3 class="text-primary-800">Objetivo general</h3>
      <div class="mt-sm">
        <TextoPendiente etiqueta="Objetivo general pendiente">
          Un solo enunciado que relacione el tema del proyecto con la comunidad y el
          territorio seleccionados. Debe iniciar con un verbo en infinitivo.
        </TextoPendiente>
      </div>
    </article>

    <!-- ---------- Objetivos específicos ---------- -->
    <article>
      <h3>Objetivos específicos</h3>
      <p class="mt-xs text-sm text-text-muted">
        Marcan de forma secuencial las etapas para alcanzar el objetivo general.
      </p>

      <ol class="mt-md flex flex-col gap-md">
        {
          OBJETIVOS_ESPECIFICOS.map((objetivo, indice) => (
            <li class="card flex items-start gap-md border border-line">
              <span
                class="flex size-11 shrink-0 items-center justify-center rounded-full bg-primary text-base font-semibold text-white"
                aria-hidden="true"
              >
                {indice + 1}
              </span>
              <div class="flex-1">
                {objetivo.pendiente ? (
                  <TextoPendiente etiqueta={`Objetivo específico ${indice + 1} pendiente`}>
                    {objetivo.texto}
                  </TextoPendiente>
                ) : (
                  <p>{objetivo.texto}</p>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </article>
  </div>
</SeccionBase>
