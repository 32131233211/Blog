---

<SeccionBase
  id="evidencias-capacitaciones"
  titulo="Evidencia y descripción de las capacitaciones"
  descripcion=""
  fondo="alt"
>
  <!-- Contenedor principal de dos columnas: Izquierda = Capacitación 2 | Derecha = Capacitación 1 -->
  <div class="grid grid-cols-1 gap-lg lg:grid-cols-2 lg:gap-xl">
    <!-- ============================================================
         COLUMNA IZQUIERDA: CAPACITACIÓN 2
         ============================================================ -->
    <article class="flex flex-col">
      <header class="border-b border-line pb-sm">
        <p
          class="text-xs font-semibold tracking-wider text-secondary uppercase"
        >
          Capacitación 2 — Sesión práctica
        </p>
        <h3 class="mt-xs text-xl text-text">
          Herramientas de comunicación digital
        </h3>
        <p class="mt-xs text-sm text-text-muted">
          <strong>Facilitador:</strong> Brando García Ariza &bull; <strong
            >Enfoque:</strong
          > WhatsApp, videollamadas, correo y ubicación.
        </p>
        <div class="mt-sm rounded-sm bg-bg p-sm border border-line">
          <p class="text-sm text-text-muted">
            <strong>Descripción de la evidencia:</strong> Registro del aprendizaje
            en el uso de canales de comunicación interactivos. Se evidencia la interacción
            práctica de los participantes redactando mensajes, respondiendo videollamadas
            de prueba y compartiendo su ubicación de forma supervisada.
          </p>
        </div>
      </header>

      <!-- Cuadrícula interna de 6 cuadros (3 filas x 2 columnas) -->
      <ul class="mt-md grid grid-cols-2 gap-sm sm:gap-md" role="list">
        {
          FOTOS_CAPACITACION_2.map((foto) => (
            <li class="flex flex-col">
              <figure class="flex h-full flex-col">
                {foto.src ? (
                  <img
                    src={foto.src}
                    alt={foto.alt}
                    class="aspect-4/3 w-full rounded-md border border-line object-cover"
                    loading="lazy"
                  />
                ) : (
                  <div
                    class="flex aspect-4/3 w-full flex-col items-center justify-center rounded-md border-2 border-dashed border-line bg-bg p-xs text-center transition-colors hover:border-primary-400"
                    aria-label={foto.etiqueta}
                  >
                    <svg
                      class="size-8 text-line sm:size-10"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <rect x="3" y="5" width="18" height="14" rx="2" />
                      <circle cx="9" cy="10" r="1.5" />
                      <path d="m4 17 5-5 4 4 3-2 4 4" />
                    </svg>
                    <span class="mt-xs text-xs font-medium text-text-muted line-clamp-1">
                      {foto.etiqueta}
                    </span>
                  </div>
                )}
                <figcaption class="mt-xs text-xs sm:text-sm text-text-muted">
                  {foto.descripcion}
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </article>

    <!-- ============================================================
         COLUMNA DERECHA: CAPACITACIÓN 1
         ============================================================ -->
    <article class="flex flex-col">
      <header class="border-b border-line pb-sm">
        <p class="text-xs font-semibold tracking-wider text-primary uppercase">
          Capacitación 1 — Sesión práctica
        </p>
        <h3 class="mt-xs text-xl text-text">
          Reconocimiento de interfaces del celular
        </h3>
        <p class="mt-xs text-sm text-text-muted">
          <strong>Facilitador:</strong> Marlon Muñoz Romero &bull; <strong
            >Enfoque:</strong
          > Interfaces, símbolos, llamadas y apps básicas.
        </p>
        <div class="mt-sm rounded-sm bg-bg p-sm border border-line">
          <p class="text-sm text-text-muted">
            <strong>Descripción de la evidencia:</strong> Registro de la sesión introductoria
            de sensibilización. Se documenta la exploración de los participantes sobre
            sus dispositivos, la identificación de los íconos de la pantalla de inicio
            y la configuración de tamaño de fuente y volumen.
          </p>
        </div>
      </header>

      <!-- Cuadrícula interna de 6 cuadros (3 filas x 2 columnas) -->
      <ul class="mt-md grid grid-cols-2 gap-sm sm:gap-md" role="list">
        {
          FOTOS_CAPACITACION_1.map((foto) => (
            <li class="flex flex-col">
              <figure class="flex h-full flex-col">
                {foto.src ? (
                  <img
                    src={foto.src}
                    alt={foto.alt}
                    class="aspect-4/3 w-full rounded-md border border-line object-cover"
                    loading="lazy"
                  />
                ) : (
                  <div
                    class="flex aspect-4/3 w-full flex-col items-center justify-center rounded-md border-2 border-dashed border-line bg-bg p-xs text-center transition-colors hover:border-primary-400"
                    aria-label={foto.etiqueta}
                  >
                    <svg
                      class="size-8 text-line sm:size-10"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <rect x="3" y="5" width="18" height="14" rx="2" />
                      <circle cx="9" cy="10" r="1.5" />
                      <path d="m4 17 5-5 4 4 3-2 4 4" />
                    </svg>
                    <span class="mt-xs text-xs font-medium text-text-muted line-clamp-1">
                      {foto.etiqueta}
                    </span>
                  </div>
                )}
                <figcaption class="mt-xs text-xs sm:text-sm text-text-muted">
                  {foto.descripcion}
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </article>
  </div>
</SeccionBase>
