---
/* ============================================================
   NUESTRO EQUIPO
   ============================================================
   Cuatro tarjetas: foto, nombre y carrera de cada integrante.

   CÓMO COMPLETAR:
   1. Copiar la foto de cada integrante a  public/assets/equipo/
      (recomendado: cuadrada, mínimo 400x400 px, formato .jpg o .webp).
   2. En el arreglo EQUIPO de abajo, poner esa ruta en `foto`
      (ej. "/assets/equipo/marlon.jpg") y escribir la `carrera`.
   Mientras `foto` sea null, la tarjeta muestra las iniciales del
   integrante dentro de un círculo, sin romper el diseño.
   ============================================================ */
import SeccionBase from "../../../components/SeccionBase.astro";

interface Integrante {
  readonly nombre: string;
  /** Programa académico que cursa. Pendiente de confirmar. */
  readonly carrera: string | null;
  /** Ruta pública de la foto. null = se muestran las iniciales. */
  readonly foto: string | null;
  /** Sesión de la capacitación que lidera. */
  readonly sesion: string;
}

const EQUIPO: readonly Integrante[] = [
  // Marlon: sin foto todavía -> la tarjeta muestra sus iniciales.
  {
    nombre: "Marlon",
    carrera: "Ingeniería de Software",
    foto: null,
    sesion: "Sesión 1",
  },
  {
    nombre: "Brando",
    carrera: "Ingeniería de Software",
    foto: "/assets/equipo/brando.jpeg",
    sesion: "Sesión 2",
  },
  {
    nombre: "Sebastián",
    carrera: "Ingeniería de Software",
    foto: "/assets/equipo/sebastian.jpg",
    sesion: "Sesión 3",
  },
  {
    nombre: "Yeimi",
    carrera: "Ingeniería de Sistemas",
    foto: "/assets/equipo/yeimi.jpeg",
    sesion: "Sesión 4",
  },
];

/** Iniciales para el marcador de foto (máximo 2 letras). */
const iniciales = (nombre: string) =>
  nombre
    .split(" ")
    .slice(0, 2)
    .map((parte) => parte.charAt(0))
    .join("")
    .toUpperCase();
---

<SeccionBase
  id="equipo"
  etiqueta="Quiénes lo hacemos"
  titulo="Nuestro equipo"
  descripcion="Estudiantes a cargo del diseño y la ejecución de las capacitaciones."
  fondo="alt"
>
  <ul class="grid grid-cols-1 gap-md sm:grid-cols-2 xl:grid-cols-4">
    {
      EQUIPO.map((integrante) => (
        <li class="card flex flex-col items-center border border-line text-center">
          {integrante.foto ? (
            <img
              src={integrante.foto}
              alt={`Foto de ${integrante.nombre}`}
              class="size-32 rounded-full border-2 border-primary-100 object-cover"
            />
          ) : (
            <span
              class="flex size-32 items-center justify-center rounded-full border-2 border-dashed border-primary-200 bg-primary-50 text-xl font-semibold text-primary-700"
              aria-hidden="true"
            >
              {iniciales(integrante.nombre)}
            </span>
          )}

          <h3 class="mt-md text-lg">{integrante.nombre}</h3>

          {integrante.carrera ? (
            <p class="mt-xs text-sm text-text-muted">{integrante.carrera}</p>
          ) : (
            <p class="mt-xs text-sm text-text-muted italic">Carrera por definir</p>
          )}

        </li>
      ))
    }
  </ul>
</SeccionBase>
