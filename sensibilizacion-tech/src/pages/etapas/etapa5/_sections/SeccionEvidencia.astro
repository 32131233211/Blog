---
/* ============================================================
   ENTRADA 5 (parte 2) — Evidencia del formulario
   ============================================================
   Un único cuadro de evidencia (no una cuadrícula): la captura
   o foto del formulario de autoevaluación diligenciado.

   Imagen ubicada en public/assets/cierre/evidencia-formulario.jpeg.
   ============================================================ */
import SeccionBase from "../../../../components/SeccionBase.astro";

interface EvidenciaFormulario {
  readonly src: string | null;
  readonly alt: string;
  readonly descripcion: string;
  readonly etiqueta: string;
}

const EVIDENCIA: EvidenciaFormulario = {
  src: "/assets/cierre/evidencia-formulario.jpeg",
  alt: "Captura del formulario de autoevaluación diligenciado por los participantes.",
  descripcion: "Formulario de autoevaluación diligenciado por los participantes.",
  etiqueta: "Evidencia — Formulario de autoevaluación",
};
---

<SeccionBase id="evidencia-formulario" titulo="Evidencia del formulario" descripcion="" fondo="alt">
  <figure class="mx-auto flex w-full max-w-md flex-col">
    {
      EVIDENCIA.src ? (
        <button
          type="button"
          class="group block w-full cursor-zoom-in overflow-hidden rounded-md border border-line"
          data-lightbox-trigger
          data-lightbox-src={EVIDENCIA.src}
          data-lightbox-alt={EVIDENCIA.alt}
          data-lightbox-caption={EVIDENCIA.descripcion}
          aria-label={`Ampliar imagen: ${EVIDENCIA.descripcion}`}
        >
          <img
            src={EVIDENCIA.src}
            alt={EVIDENCIA.alt}
            class="aspect-4/3 w-full object-contain bg-bg-alt p-xs transition-transform duration-200 group-hover:scale-105"
            loading="lazy"
          />
        </button>
      ) : (
        <div
          class="flex aspect-4/3 w-full flex-col items-center justify-center rounded-md border-2 border-dashed border-line bg-bg p-sm text-center transition-colors hover:border-primary-400"
          aria-label={EVIDENCIA.etiqueta}
        >
          <svg
            class="size-10 text-line"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <circle cx="9" cy="10" r="1.5" />
            <path d="m4 17 5-5 4 4 3-2 4 4" />
          </svg>
          <span class="mt-xs text-sm font-medium text-text-muted">
            {EVIDENCIA.etiqueta}
          </span>
        </div>
      )
    }
    <figcaption class="mt-xs text-center text-sm text-text-muted">
      {EVIDENCIA.descripcion}
    </figcaption>
  </figure>
</SeccionBase>

<!-- ============================================================
     LIGHTBOX — visor de imagen ampliada, mismo patrón que el de
     Entrada 4 (SeccionEvidencias.astro). Se activa desde el botón
     [data-lightbox-trigger] de arriba.
     ============================================================ -->
<dialog
  id="lightbox-evidencia-formulario"
  class="m-auto w-[min(92vw,56rem)] max-h-[90vh] rounded-lg border border-line bg-bg p-0 open:flex open:flex-col"
>
  <div class="flex items-center justify-between gap-sm border-b border-line p-sm">
    <p id="lightbox-evidencia-formulario-caption" class="text-sm text-text-muted pr-sm">&nbsp;</p>
    <button
      type="button"
      id="lightbox-evidencia-formulario-cerrar"
      class="flex size-11 shrink-0 items-center justify-center rounded-sm text-text hover:bg-bg-alt"
      aria-label="Cerrar imagen ampliada"
    >
      <svg
        class="size-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M18 6 6 18"></path>
        <path d="m6 6 12 12"></path>
      </svg>
    </button>
  </div>
  <div class="flex-1 overflow-auto p-sm">
    <img
      id="lightbox-evidencia-formulario-imagen"
      src=""
      alt=""
      class="mx-auto max-h-[75vh] w-auto rounded-sm object-contain"
    />
  </div>
</dialog>

<script>
  // El <ClientRouter /> de BaseLayout navega sin recargar la página, y
  // Astro deduplica scripts inline por contenido: un script idéntico al
  // de otra pantalla no se vuelve a ejecutar al navegar entre ellas. Por
  // eso la lógica va enganchada a "astro:page-load" (se dispara en la
  // carga inicial Y en cada navegación del router) en vez de correr una
  // sola vez a nivel de módulo — si no, el zoom deja de responder tras
  // navegar por el menú.
  document.addEventListener("astro:page-load", () => {
    const dialogo = document.querySelector<HTMLDialogElement>(
      "#lightbox-evidencia-formulario",
    );
    const imagen = document.querySelector<HTMLImageElement>(
      "#lightbox-evidencia-formulario-imagen",
    );
    const leyenda = document.querySelector<HTMLParagraphElement>(
      "#lightbox-evidencia-formulario-caption",
    );
    const botonCerrar = document.querySelector<HTMLButtonElement>(
      "#lightbox-evidencia-formulario-cerrar",
    );

    if (dialogo && imagen && leyenda && botonCerrar) {
      document
        .querySelectorAll<HTMLButtonElement>("[data-lightbox-trigger]")
        .forEach((boton) => {
          boton.addEventListener("click", () => {
            const src = boton.dataset.lightboxSrc ?? "";
            imagen.src = src;
            imagen.alt = boton.dataset.lightboxAlt ?? "";
            leyenda.textContent = boton.dataset.lightboxCaption ?? "";
            dialogo.showModal();
          });
        });

      botonCerrar.addEventListener("click", () => dialogo.close());

      dialogo.addEventListener("click", (evento) => {
        if (evento.target === dialogo) {
          dialogo.close();
        }
      });

      dialogo.addEventListener("close", () => {
        imagen.src = "";
      });
    }
  });
</script>

<style>
  #lightbox-evidencia-formulario::backdrop {
    background-color: rgb(40 40 40 / 80%);
  }
</style>
