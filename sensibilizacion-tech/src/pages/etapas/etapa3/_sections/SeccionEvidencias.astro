---
/* ============================================================
   ENTRADA 3 (parte 2) — Evidencia (fotos) y Descripción
   ============================================================
   Estructura simétrica de dos columnas principales:
     · Columna Izquierda: Capacitación 2 (Comunicaciones y apps).
     · Columna Derecha: Capacitación 1 (Reconocimiento del celular).

   Cada columna contiene una cuadrícula idéntica de 6 cuadros de
   imagen distribuidos en 3 filas (2 cuadros por fila):
     - Fila 1: Cuadros 1 y 2
     - Fila 2: Cuadros 3 y 4
     - Fila 3: Cuadros 5 y 6

   CÓMO ASIGNAR FOTOS REALES:
   Colocar los archivos en public/assets/evidencias/ (o ruta pública),
   y reemplazar `src: null` por la ruta correspondiente (ej. "/assets/evidencias/foto1.jpg"),
   ajustando también el texto descriptivo de `alt` y `descripcion`.
   ============================================================ */
import SeccionBase from "../../../../components/SeccionBase.astro";

interface FotoEvidencia {
  /** Ruta pública del archivo de imagen. Si es null, renderiza el cuadro de reserva punteado. */
  readonly src: string | null;
  /** Texto alternativo accesible que describe el contenido de la imagen. */
  readonly alt: string;
  /** Pie de foto o descripción detallada de la evidencia. */
  readonly descripcion: string;
  /** Etiqueta indicativa del cuadro mientras esté pendiente de imagen. */
  readonly etiqueta: string;
}

/* ------------------------------------------------------------
   COLUMNA IZQUIERDA: CAPACITACIÓN 2 (6 cuadros en 3 filas de 2)
   Facilitador: Brando García | Temática: Comunicaciones
   ------------------------------------------------------------ */
const FOTOS_CAPACITACION_2: readonly FotoEvidencia[] = [
  // Fila 1 (2 cuadros)
  {
    src: null,
    alt: "Participante realizando una llamada y configurando contactos en su celular.",
    descripcion:
      "Práctica guiada en la libreta de contactos y realización de llamadas telefónicas.",
    etiqueta: "Cuadro 1 — Contactos y llamadas",
  },
  {
    src: null,
    alt: "Demostración del envío de mensajes y notas de voz a través de WhatsApp.",
    descripcion:
      "Envío seguro de mensajes de texto, audios e imágenes por WhatsApp.",
    etiqueta: "Cuadro 2 — Mensajería instantánea",
  },
  // Fila 2 (2 cuadros)
  {
    src: null,
    alt: "Participante interactuando en videollamada de prueba con su facilitador.",
    descripcion:
      "Uso de la cámara, micrófono y funciones durante una videollamada.",
    etiqueta: "Cuadro 3 — Videollamadas",
  },
  {
    src: null,
    alt: "Pantalla del celular mostrando cómo compartir la ubicación en tiempo real.",
    descripcion:
      "Explicación paso a paso para compartir la ubicación en caso de necesidad.",
    etiqueta: "Cuadro 4 — Compartir ubicación",
  },
  // Fila 3 (2 cuadros)
  {
    src: null,
    alt: "Creación y consulta de la bandeja de entrada del correo electrónico.",
    descripcion:
      "Reconocimiento del correo electrónico institucional y personal en el móvil.",
    etiqueta: "Cuadro 5 — Correo electrónico",
  },
  {
    src: null,
    alt: "Uso de la cámara del celular para escanear un documento físico.",
    descripcion:
      "Digitalización sencilla de documentos con la cámara del dispositivo.",
    etiqueta: "Cuadro 6 — Escaneo de documentos",
  },
];

/* ------------------------------------------------------------
   COLUMNA DERECHA: CAPACITACIÓN 1 (6 cuadros en 3 filas de 2)
   Facilitador: Marlon Muñoz | Temática: Reconocimiento de celular
   ------------------------------------------------------------ */
const FOTOS_CAPACITACION_1: readonly FotoEvidencia[] = [
  // Fila 1 (2 cuadros)
  {
    src: null,
    alt: "Presentación inicial del equipo y bienvenida a los adultos mayores participantes.",
    descripcion:
      "Apertura de la sesión y encuadre inicial sobre los componentes del móvil.",
    etiqueta: "Cuadro 1 — Introducción y bienvenida",
  },
  {
    src: null,
    alt: "Identificación de botones físicos y áreas táctiles de la pantalla.",
    descripcion:
      "Reconocimiento de botones físicos (encendido, volumen) y gestos en pantalla.",
    etiqueta: "Cuadro 2 — Botones y pantalla táctil",
  },
  // Fila 2 (2 cuadros)
  {
    src: null,
    alt: "Explicación visual de los íconos de la barra de estado: batería, wifi y señal.",
    descripcion:
      "Lectura de íconos de estado: wifi, nivel de batería, volumen y señal.",
    etiqueta: "Cuadro 3 — Barra de estado y símbolos",
  },
  {
    src: null,
    alt: "Navegación en la pantalla principal y organización de aplicaciones prioritarias.",
    descripcion:
      "Ubicación de las aplicaciones de uso frecuente en la pantalla de inicio.",
    etiqueta: "Cuadro 4 — Pantalla de inicio y apps",
  },
  // Fila 3 (2 cuadros)
  {
    src: null,
    alt: "Configuración del tamaño de letra y brillo de pantalla para mayor legibilidad.",
    descripcion:
      "Ajustes de accesibilidad: ampliación de texto y regulación del brillo.",
    etiqueta: "Cuadro 5 — Ajustes de accesibilidad",
  },
  {
    src: null,
    alt: "Espacio de preguntas, repaso y resolución de inquietudes individuales.",
    descripcion:
      "Ronda de práctica autónoma con acompañamiento individualizado.",
    etiqueta: "Cuadro 6 — Práctica individual y cierre",
  },
