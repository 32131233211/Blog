    descripcion: "Inicio y presentación de la capacitación.",
    etiqueta: "Cuadro 1 — Presentación de la capacitación",
  },
  {
    src: "/assets/sesion-3/Foto2.png",
    alt: "Identificación de remitentes no verificados y señales de phishing en la bandeja de correo electrónico.",
    descripcion: "Experiencias vividas con intetos de Fraudes.",
    etiqueta: "Cuadro 2 — Experiencias vividas con intetos de Fraudes",
  },
  // Fila 2 (2 cuadros)
  {
    src: "/assets/sesion-3/Foto3.png",
    alt: "Estrategia pedagógica para crear contraseñas robustas y memorables mediante frases clave.",
    descripcion: "Explicación de como esta construido un mensaje Fraudulento.",
    etiqueta: "Cuadro 3 — Manejo seguro de contraseñas",
  },
  {
    src: "/assets/sesion-3/Foto4.png",
    alt: "Explicación del segundo factor de autenticación (MFA) con código de verificación temporal en el celular.",
    descripcion: "Actividad para reconocer mensajes engañosos.",
    etiqueta: "Cuadro 4 — Construcción de mensajes Fraudulentos",
  },
  // Fila 3 (2 cuadros)
  {
